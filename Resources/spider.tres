[resource]
script = ExtResource("1_pt0mt")
npc_name = "Spider"
sprite_frame = 3
dialogue = "Dungeon Master, adventurers keep escaping through the eastern tunnels. Let me fill the passages with webs, and none shall escape my grasp! (10 Gold)"
agree_dialogue = "Excellent. My webs will be in place, and the tunnels are mine now."
agree_money = -10
agree_power = 5
agree_reputation = 1
agree_loyalty = 8
disagree_dialogue = "You would waste a hunter’s talents like this? Very well. I won’t bother maintaining webs near the entrances if you have no use for them."
disagree_power = -1
disagree_reputation = 1
disagree_loyalty = -5
