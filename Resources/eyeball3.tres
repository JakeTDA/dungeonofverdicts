[ext_resource type="Script" uid="uid://bnr4vchrtqj2t" path="res://Scripts/npc.gd" id="1_8r3yv"]

[resource]
script = ExtResource("1_8r3yv")
dialogue = "Master! I have detected a secret chamber beneath the dungeon. There may be an enormous treasure hidden inside, but the entrance is protected by an unknown ancient magic. Shall we investigate?"
agree_dialogue = "We'll get to the bottom of that chamber if it's the last thing we do!"
disagree_dialogue = "Some things are better off staying secret. After all, ignorance is bliss!"
